# Pfad zu deinem Obsidian Vault
# Kann absolut oder relativ angegeben werden (auch ~ wird aufgelöst)
OBSIDIAN_VAULT_PATH="/path/to/your/obsidian-vault"

# Optionaler Unterordner innerhalb des Vaults, in dem Karriere-/Bewerbungsnotizen liegen
# z.B. "02 Areas/Career" oder "Career" (leer lassen = ganzer Vault)
OBSIDIAN_CAREER_SUBDIR="02 Areas/Career"

# Standard-Sprache der generierten Unterlagen (de oder en)
DEFAULT_LANG="de"

# Ausgabeordner für generierte Unterlagen
OUTPUT_DIR="./output"

# Akzentfarbe für das Typst-Template (z.B. "#1a5fb4", "#204a87", "#0d5c75", "#e65100")
CV_ACCENT_COLOR="#1a5fb4"
